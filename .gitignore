# Zugangsdaten – der GANZE Ordner, nicht nur die .env.
#
# Hier lagen bis zum 29.07.2026 nur `config/.env`. Eine
# `client_secret.json` daneben waere von Git klaglos mitgenommen worden –
# und in einem Repo, das einen oeffentlichen Spiegel hat, ist das nicht
# wiedergutzumachen. Deshalb: alles ausschliessen, die Beschreibung
# ausdruecklich wieder hereinholen.
config/*
!config/LIESMICH.md

# lokale Daten
data/

# erzeugte Bilder, Zwischenstaende, fertige Videos
probe/
probe_*/
branding/
frames/
out/
*.mp4
*.wav

# Schriftdateien werden nicht ins Git gelegt (Lizenz je Schrift pruefen)
assets/fonts/*.ttf
assets/fonts/*.otf

# Python
__pycache__/
*.pyc

# Betriebssystem
Thumbs.db
Desktop.ini
